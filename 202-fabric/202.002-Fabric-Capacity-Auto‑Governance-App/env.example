# ==============================================================================
# Fabric Capacity Auto-Governance App — Variables de entorno
# ==============================================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio (está en .gitignore).
# En producción estas variables se configuran en:
#   - Azure Automation Account → Variables (encriptadas)
#   - Fabric Notebooks → no usan .env directamente, configurar en CONFIG dict
# ==============================================================================


# ── Azure / Fabric Identity ────────────────────────────────────────────────────

# Tenant de Azure AD
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Service Principal usado por el Automation Runbook
# Necesita rol: Contributor sobre la Fabric capacity
#               Reader sobre el Resource Group
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret-here

# Subscription donde vive la Fabric capacity
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# ── Fabric Capacity ────────────────────────────────────────────────────────────

# GUID de la capacity a gestionar
# Fabric Portal → Capacities → [tu capacity] → Settings → copy ID from URL
FABRIC_CAPACITY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Nombre legible (solo documentativo, no se usa en código)
FABRIC_CAPACITY_NAME=my-fabric-capacity

# Resource group donde está la capacity
FABRIC_RESOURCE_GROUP=rg-fabric-prod

# SKU actual (F2 | F4 | F8 | F16 | F32 | F64 | F128 | F256 | F512 | F1024 | F2048)
FABRIC_CAPACITY_SKU_DEFAULT=F8


# ── Lakehouse AutoScaling ──────────────────────────────────────────────────────

# Nombre del Lakehouse dedicado al sistema (creado manualmente en Fabric)
FABRIC_LAKEHOUSE_NAME=AutoScalingSystem

# Workspace ID de Fabric (URL del workspace → GUID al final)
FABRIC_WORKSPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# ── Azure Automation Account ───────────────────────────────────────────────────

AUTOMATION_ACCOUNT_NAME=aa-fabric-governance
AUTOMATION_RESOURCE_GROUP=rg-fabric-prod
# Nombre del runbook principal (Capa 4)
AUTOMATION_RUNBOOK_NAME=guardian_and_scale


# ── Budget y límites de escalado ──────────────────────────────────────────────

# Coste máximo mensual en EUR (el motor de decisión respeta este límite)
BUDGET_MAX_MONTHLY_EUR=500.0

# SKU mínimo permitido (no bajará de este SKU aunque el score sea muy bajo)
SCALING_SKU_MIN=F2

# SKU máximo permitido (no subirá de este SKU aunque el score sea muy alto)
SCALING_SKU_MAX=F64

# Cooldown en minutos entre acciones de escalado (evita flapping)
SCALING_COOLDOWN_MINUTES=15


# ── Comportamiento del sistema ─────────────────────────────────────────────────

# Intervalo de scheduling en minutos (debe coincidir con el schedule de Automation)
COLLECTION_INTERVAL_MINUTES=5

# Modo dry_run global: "true" | "false"
# En producción debe ser "false"
DRY_RUN=false
