# ==============================================================================
# Fabric Capacity Auto-Governance App — .gitignore
# ==============================================================================


# ── Secretos y configuración local ────────────────────────────────────────────
.env
*.env.local
*.env.prod
secrets/
credentials/


# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# Entornos virtuales
.venv/
venv/
env/
ENV/
.python-version


# ── Jupyter / Notebooks locales ───────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
# Nota: los notebooks de Fabric se editan en el portal, los .py de esta repo
# son la fuente de verdad para control de versiones.


# ── IDEs y editores ────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db


# ── Testing y coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover


# ── Logs locales ──────────────────────────────────────────────────────────────
logs/
*.log
*.log.*


# ── Artefactos de modelos (Prophet / sklearn) ─────────────────────────────────
# Los modelos no se persisten en disco en esta arquitectura (se reentrenan en cada run)
# Si en el futuro se serializan, ignorar aquí:
models/
*.pkl
*.joblib
*.json.model


# ── Azure / Bicep (v2) ────────────────────────────────────────────────────────
# Outputs de deploys que no deben versionarse
infra/*.json
infra/output/
.azure/


# ── Datos locales de prueba ───────────────────────────────────────────────────
data/
sample_data/
*.csv
*.parquet
*.delta
